<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Parity">
            <directory>tests/Parity</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            MySQL 8 is the authoritative test database. force="true" wins over a
            local .env that still points at SQLite. These values match
            .env.testing and the mysql:8.0 service in .github/workflows/ci.yml.
            There is no Pest config.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="laramine_testing" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="password" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- The frontend job compiles the SSR bundle. PHPUnit must not call Node. -->
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <!--
            Live LDAP comparison. These values match the OpenLDAP service in
            .github/workflows/ci.yml and tests/Parity/fixtures/redmine-7.0.1/expectations/auth/ldap-live.json.
        -->
        <env name="LDAP_HOST" value="127.0.0.1" force="true"/>
        <env name="LDAP_PORT" value="389" force="true"/>
        <env name="LDAP_TLS_PORT" value="636" force="true"/>
        <env name="LDAP_BASE_DN" value="dc=example,dc=test" force="true"/>
        <env name="LDAP_ADMIN_DN" value="cn=admin,dc=example,dc=test" force="true"/>
        <env name="LDAP_ADMIN_PASSWORD" value="adminsecret" force="true"/>
        <env name="LDAP_CONFIG_DN" value="cn=admin,cn=config" force="true"/>
        <env name="LDAP_CONFIG_PASSWORD" value="adminsecret" force="true"/>
        <env name="LDAP_PEOPLE_DN" value="ou=people,dc=example,dc=test" force="true"/>
    </php>
</phpunit>
